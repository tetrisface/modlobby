# Copy to .env (gitignored). modlobby-cli and a dev run of the app load it at startup; real environment variables win.
# Desktop app only. An installed app has no .env, so set it in the real environment there.

# memory: keep passwords for this run only, never in the OS keyring. The keyring is shared
# by every instance of the user, whatever MODLOBBY_CONFIG_DIR says; a test instance sets this.
# MODLOBBY_CREDENTIALS=memory
