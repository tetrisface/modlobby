{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "modlobby",
  "version": "0.1.0",
  "identifier": "dev.modlobby.app",
  "build": {
    "beforeDevCommand": "bun run vite:dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run vite:build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "modlobby",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://maps-metadata.beyondallreason.dev; font-src 'self' data:; worker-src 'self' blob:; connect-src ipc: http://ipc.localhost https://maps-metadata.beyondallreason.dev"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
