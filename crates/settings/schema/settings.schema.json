{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Settings",
  "type": "object",
  "properties": {
    "$schema": {
      "description": "Points editors at the schema next to the file.",
      "type": [
        "string",
        "null"
      ]
    },
    "account": {
      "$ref": "#/$defs/Account",
      "default": {
        "autoLogin": false,
        "rememberPassword": false,
        "username": ""
      }
    },
    "battleList": {
      "$ref": "#/$defs/BattleList",
      "default": {
        "mode": "all",
        "showEmpty": true,
        "showLocked": true,
        "showPassworded": true,
        "showRunning": true,
        "sort": "relevance",
        "sortDescending": false
      }
    },
    "chat": {
      "$ref": "#/$defs/Chat",
      "default": {
        "maxLines": 500
      }
    },
    "logging": {
      "$ref": "#/$defs/Logging",
      "default": {
        "filter": "info"
      }
    },
    "paths": {
      "$ref": "#/$defs/Paths",
      "default": {
        "dataDir": null
      }
    },
    "server": {
      "$ref": "#/$defs/Server",
      "default": {
        "host": "server4.beyondallreason.info",
        "port": 8201,
        "tls": true
      }
    },
    "tweaks": {
      "$ref": "#/$defs/Tweaks",
      "default": {
        "defaultSlot": "tweakdefs1",
        "styluaConfig": null
      }
    }
  },
  "$defs": {
    "Account": {
      "type": "object",
      "properties": {
        "autoLogin": {
          "description": "Log in on startup with the remembered password. Without one there is\nnothing to log in with, so this does nothing on its own.",
          "type": "boolean",
          "default": false
        },
        "rememberPassword": {
          "description": "Keep the password in the OS keyring between runs; it is never written here.",
          "type": "boolean",
          "default": false
        },
        "username": {
          "type": "string",
          "default": ""
        }
      }
    },
    "BattleList": {
      "description": "Which rooms the list shows. Chobby words these the other way round, as\n\"Filter out:\" checkboxes, where ticking one means seeing less; stated\npositively, a toggle that is on means that kind of room is in the list.",
      "type": "object",
      "properties": {
        "mode": {
          "$ref": "#/$defs/ModeFilter",
          "default": "all"
        },
        "showEmpty": {
          "description": "Rooms nobody has joined yet.",
          "type": "boolean",
          "default": true
        },
        "showLocked": {
          "type": "boolean",
          "default": true
        },
        "showPassworded": {
          "type": "boolean",
          "default": true
        },
        "showRunning": {
          "description": "Rooms whose game has already started.",
          "type": "boolean",
          "default": true
        },
        "sort": {
          "$ref": "#/$defs/BattleSort",
          "default": "relevance"
        },
        "sortDescending": {
          "description": "Largest or latest first. Ignored by `BattleSort::Relevance`, which has\na fixed order of its own.",
          "type": "boolean",
          "default": false
        }
      }
    },
    "BattleSort": {
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "players",
            "title",
            "map",
            "host"
          ]
        },
        {
          "description": "Chobby's own order: joinable first, then busy, then locked, then\npassworded, with player count deciding inside each band.",
          "type": "string",
          "const": "relevance"
        }
      ]
    },
    "Chat": {
      "type": "object",
      "properties": {
        "maxLines": {
          "description": "Lines kept per room before the oldest are dropped.",
          "type": "integer",
          "format": "uint32",
          "default": 500,
          "minimum": 0
        }
      }
    },
    "Logging": {
      "type": "object",
      "properties": {
        "filter": {
          "description": "A `tracing` filter, e.g. `info,spring::rx=trace`.",
          "type": "string",
          "default": "info"
        }
      }
    },
    "ModeFilter": {
      "description": "Player-versus-what. Read off the room title, which is all the list has:\nthe server only sends a room's AI once you are in it.",
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "all"
          ]
        },
        {
          "description": "Only rooms that look like they are against AI.",
          "type": "string",
          "const": "pve"
        },
        {
          "description": "Only rooms that do not.",
          "type": "string",
          "const": "pvp"
        }
      ]
    },
    "Paths": {
      "type": "object",
      "properties": {
        "dataDir": {
          "description": "The BAR data directory (`engine/`, `games/`, `maps/`); the launcher's when unset.",
          "type": [
            "string",
            "null"
          ],
          "default": null
        }
      }
    },
    "Server": {
      "description": "Which teiserver to talk to.",
      "type": "object",
      "properties": {
        "host": {
          "type": "string",
          "default": "server4.beyondallreason.info"
        },
        "port": {
          "type": "integer",
          "format": "uint16",
          "default": 8201,
          "maximum": 65535,
          "minimum": 0
        },
        "tls": {
          "description": "teiserver speaks TLS on 8201 and plain TCP on 8200.",
          "type": "boolean",
          "default": true
        }
      }
    },
    "Tweaks": {
      "type": "object",
      "properties": {
        "defaultSlot": {
          "description": "Slot offered when exporting a tweak, e.g. `tweakdefs1`.",
          "type": "string",
          "default": "tweakdefs1"
        },
        "styluaConfig": {
          "description": "A `stylua.toml` to format tweak Lua with; StyLua's defaults when unset.",
          "type": [
            "string",
            "null"
          ],
          "default": null
        }
      }
    }
  }
}